# Darou Rahman Chicken — Configuration du serveur API
# Copiez ce fichier vers .env et adaptez les valeurs, OU exportez ces variables
# dans votre shell / fichier systemd avant de lancer : node server.js
# Ce serveur ne lit PAS automatiquement un fichier .env (aucune dépendance) :
# utilisez `set -a; . ./.env; set +a; node server.js` ou définissez-les ailleurs.

# Port d'écoute du serveur (défaut : 8080)
PORT=8080

# Jeton d'administration pour GET /api/admin/orders (en-tête x-admin-token)
# IMPORTANT : changez cette valeur avant toute mise en production.
ADMIN_TOKEN=changeme

# Livreur principal : son code d'accès au portail /livreur (ex. DRC-1234-5678), recréé
# automatiquement même si la base repart de zéro. Les autres livreurs se créent dans
# l'espace gérant (onglet Livreurs), chacun avec son propre code.
DRIVER_TOKEN=
DRIVER_ID=driver-1
DRIVER_NAME=Livreur DRC
DRIVER_PHONE=

# Point de départ des tournées affiché au livreur (défaut : Parcelles Assainies U20).
DEPOT_LAT=14.757605
DEPOT_LNG=-17.445161
DEPOT_LABEL=Dépôt DRC · Parcelles Assainies U20

# Numéro de téléphone de la boutique affiché pour les paiements manuels
SHOP_PHONE=+221 77 000 00 00

# --- Wave (Wave Checkout API) -------------------------------------------
# Jeton API marchand Wave (Bearer token). Si absent, les paiements Wave
# basculent automatiquement sur les instructions de paiement manuelles.
WAVE_API_TOKEN=
# Nom du marchand Wave (optionnel, affiché sur la page de paiement)
WAVE_MERCHANT_NAME=Darou Rahman Chicken

# --- Orange Money (Orange Money Web Payment API) ------------------------
# Clé marchande Orange Money. Les deux variables sont requises pour activer
# les liens de paiement Orange Money automatiques.
ORANGE_MERCHANT_KEY=
# Jeton d'accès (Bearer) Orange Money. Si absent, fallback instructions manuelles.
ORANGE_MERCHANT_TOKEN=
